# Soto System Digital Solution - Backend Gitignore

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
*.swp
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (SECURITY: Never commit real credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs
.vscode/
.idea/

build-win-final/
dist-electron/
win-unpacked/
*.exe
venv/
.venv/
db.sqlite3
